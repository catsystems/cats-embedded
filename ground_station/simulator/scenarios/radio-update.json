{
  "initial": {"ready": true},
  "steps": [
    {"press": "right"},
    {"press": "right"},
    {"press": "down"},
    {"press": "ok"},
    {"press": "right"},
    {"press": "right"},
    {"press": "down"},
    {"press": "down"},
    {"press": "down"},
    {"press": "down"},
    {"press": "ok"},
    {"assert": {"activeScreen": "firmware_update", "firmwareUpdateSelection": 0}},
    {"snapshot": "firmware-update-menu"},
    {"press": "down"},
    {"assert": {"activeScreen": "firmware_update", "firmwareUpdateSelection": 1}},
    {"press": "ok"},
    {"assert": {"activeScreen": "radio_update", "emittedAction": "radio_update_browse"}},
    {"snapshot": "radio-update-list"},
    {"press": "ok"},
    {"snapshot": "radio-update-confirm"},
    {"press": "ok"},
    {"assert": {"activeScreen": "radio_update", "radioUpdateState": "updating",
                 "radioUpdateLink": 1, "radioUpdatePercent": 0,
                 "emittedAction": "radio_update_started"}},
    {"advance": 1000},
    {"assert": {"radioUpdateState": "updating", "radioUpdateLink": 1, "radioUpdatePercent": 50}},
    {"snapshot": "radio-update-progress"},
    {"advance": 1000},
    {"assert": {"radioUpdateState": "updating", "radioUpdateLink": 2, "radioUpdatePercent": 0}},
    {"advance": 2000},
    {"assert": {"activeScreen": "radio_update", "radioUpdateState": "complete",
                 "radioUpdateLink": 2, "radioUpdatePercent": 100,
                 "emittedAction": "radio_update_complete"}},
    {"snapshot": "radio-update-complete"},
    {"press": "back"},
    {"assert": {"activeScreen": "firmware_update", "firmwareUpdateSelection": 1,
                 "radioUpdateState": "browse", "radioUpdateLink": 0, "radioUpdatePercent": 0}},
    {"press": "back"},
    {"assert": {"activeScreen": "settings", "settingsPage": 2, "settingsSelection": 3}}
  ]
}
